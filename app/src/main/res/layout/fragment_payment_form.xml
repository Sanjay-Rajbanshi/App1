<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Main Content -->
        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="30dp"
            tools:context=".presentation.payment.PaymentFormFragment">

            <!-- Header -->
            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/payment_details"
                android:textColor="#172554"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="26dp"/>



            <!-- Amount -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/amount"
                android:textColor="#334155"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAmount"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_payment_input"
                android:hint="@string/enter_amount"
                android:importantForAutofill="no"
                android:inputType="number"
                android:imeOptions="actionNext"
                android:maxLength="19"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="16sp"
                tools:ignore="LabelFor" />

            <!-- Card Number -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/card_number"
                android:textColor="#334155"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCardNumber"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_payment_input"
                android:hint="@string/_1234_5678_9012_3456"
                android:importantForAutofill="no"
                android:inputType="number"
                android:imeOptions="actionNext"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="16sp"
                tools:ignore="LabelFor" />

            <!-- Card Holder -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/card_holder_name"
                android:textColor="#334155"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCardHolderName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_payment_input"
                android:hint="@string/name_on_card"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:imeOptions="actionNext"
                android:maxLength="35"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="16sp"
                tools:ignore="LabelFor" />

            <!-- CVV + Expiry -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- CVV -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/cvv"
                        android:textColor="#334155"
                        android:textSize="14sp"
                        android:textStyle="bold" />


                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/cvvInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:layout_marginEnd="8dp"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCvv"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:hint="@string/cvv"
                            android:importantForAutofill="no"
                            android:inputType="numberPassword"
                            android:imeOptions="actionNext"
                            android:maxLength="3"
                            android:textColor="#0F172A"
                            android:textColorHint="#94A3B8"
                            android:textSize="16sp"
                            tools:ignore="LabelFor" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- Expiry -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/expiry_date"
                        android:textColor="#334155"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etExpiryDate"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="7dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_payment_input"
                        android:digits="0123456789/"
                        android:hint="@string/mm_yy"
                        android:importantForAutofill="no"
                        android:inputType="datetime"
                        android:maxLength="5"
                        android:imeOptions="actionNext"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:textSize="16sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Remarks -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/remarks"
                android:textColor="#334155"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Proceed Button -->
            <EditText
                android:id="@+id/etRemarks"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_payment_input"
                android:gravity="top"
                android:hint="@string/remarks"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:padding="16dp"
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="16sp"
                tools:ignore="LabelFor" />

            <Button
                android:id="@+id/btnProceed"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="26dp"
                android:backgroundTint="#4F46E5"
                android:text="@string/proceed"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- Payment Processing Overlay -->
        <FrameLayout
            android:id="@+id/loadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#990F172A"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_payment_loading"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp">

                <ProgressBar
                    android:id="@+id/paymentProgress"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/tvPaymentProcessing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="@string/payment_processing"
                    android:textColor="#172554"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center"
                    android:text="@string/please_wait"
                    android:textColor="#64748B"
                    android:textSize="14sp" />

            </LinearLayout>

        </FrameLayout>

    </FrameLayout>

</ScrollView>